     "dateModified": "2026-07-03","@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Quali documenti servono sempre al rogito?", "acceptedAnswer": {"@type": "Answer", "text": "Identità e codice fiscale delle parti, catena titoli (provenienza), dati catastali, APE valido; il notaio indica l'elenco puntuale in base al caso."}}, {"@type": "Question", "name": "La conformità urbanistica è obbligatoria?", "acceptedAnswer": {"@type": "Answer", "text": "Non sempre per legge, ma è fortemente consigliata se esistono ampliamenti, difformità o titoli edilizi incompleti."}}, {"@type": "Question", "name": "Chi verifica catasto e urbanistica?", "acceptedAnswer": {"@type": "Answer", "text": "Il notaio controlla gli atti; per un sopralluogo e un parere tecnico approfondito conviene un tecnico abilitato scelto dalle parti."}}, {"@type": "Question", "name": "Cosa serve in condominio?", "acceptedAnswer": {"@type": "Answer", "text": "Dichiarazione dell'amministratore sul saldo spese, di norma aggiornata alla data del rogito."}}, {"@type": "Question", "name": "Il preliminare va registrato?", "acceptedAnswer": {"@type": "Answer", "text": "Sì, va registrato all'Agenzia delle Entrate con imposta di registro e bollo secondo le regole applicabili."}}]}</script>
